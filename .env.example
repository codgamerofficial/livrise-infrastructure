# =============================================================================
# LIVRISE INFRASTRUCTURE DIGITAL ENGINEERING PLATFORM
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in your real API credentials below.
# 3. For local offline demo mode, default fallback values are provided in the code.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC BRAND SETTINGS
# -----------------------------------------------------------------------------
# Public canonical base URL (Local: http://localhost:3000 | Production: https://livrise.in)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public branding & contact details
NEXT_PUBLIC_APP_NAME="LivRise Infrastructure"
NEXT_PUBLIC_COMPANY_NAME="LivRise Infrastructure"
NEXT_PUBLIC_APP_TAGLINE="Engineering • Architecture • Infrastructure | Building Ideas Into Reality."
NEXT_PUBLIC_CONTACT_EMAIL="livriseinfrastructure@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+91 6296603868"
NEXT_PUBLIC_WHATSAPP_NUMBER="916296603868"

# -----------------------------------------------------------------------------
# 2. SUPABASE BACKEND (Database, Auth, Storage, Realtime)
# -----------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Settings > API
# URL: https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (safe for browser exposure, enforced with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only service role key (NEVER expose to client-side; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage Buckets
NEXT_PUBLIC_STORAGE_BUCKET_DOCUMENTS=project-documents
NEXT_PUBLIC_STORAGE_BUCKET_PORTFOLIO=portfolio-media
NEXT_PUBLIC_STORAGE_BUCKET_PUBLIC=public-assets

# -----------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL & NOTIFICATIONS
# -----------------------------------------------------------------------------
# Active email provider: 'resend' | 'console' (for local debugging)
EMAIL_PROVIDER=resend

# Resend API Key from https://resend.com (starts with re_)
RESEND_API_KEY=re_your_resend_api_key

# Destination inbox for incoming client project enquiries
ADMIN_NOTIFICATION_EMAIL=livriseinfrastructure@gmail.com

# Verified sender email in Resend (e.g. notifications@livrise.in or onboarding@resend.dev during dev)
EMAIL_FROM="LivRise Infrastructure <notifications@livrise.in>"

# -----------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Optional: Milestone Retainers / Drawing Sets)
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=rzp_test_yourKeyId
PAYMENT_GATEWAY_KEY_SECRET=yourKeySecret

# -----------------------------------------------------------------------------
# 5. TELEMETRY & ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
